# Copier en .env pour un test local — en production, ces valeurs vivent dans Render (sync: false)
# ou dans Doppler, jamais dans Git.

PAGE_ACCESS_TOKEN=          # token de la page Eaglestone Belgique (permission pages_manage_engagement)
APP_SECRET=                 # secret de l'app Meta (vérif de la signature webhook) — fortement recommandé en prod
WEBHOOK_VERIFY_TOKEN=gem-verify-2026

BROCHURE_URL=https://gembyeaglestone.be/brochure
TRIGGER_WORDS=brochure

# ID des posts publiés -> langue, ex. "17912345:FR,17912346:NL,17912347:EN"
# Le post ORGANIQUE (EN uniquement, un seul post) n'a pas besoin d'entrée ici : il tombe
# sur DEFAULT_LANG. Cette map sert surtout aux 3 ad sets de la campagne payante (FR/NL/EN).
MEDIA_LANG_MAP=
DEFAULT_LANG=EN

# Optionnel : alerte Telegram à chaque brochure envoyée
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Endpoint /leads?key=... (reporting) — vide = désactivé
STATS_KEY=

DB_PATH=gem_ig.db
